<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>org.archarina64.android</ApplicationId>
    <ApplicationVersion>14</ApplicationVersion>
    <ApplicationDisplayVersion>0.2.3</ApplicationDisplayVersion>
    <ApplicationTitle>Archarina64 Android</ApplicationTitle>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Archarina64.Core/Archarina64.Core.csproj" /></ItemGroup>
</Project>
